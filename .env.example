# demo works without credentials; openai enables general natural-language orchestration
COS_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
COS_TIMEZONE=America/New_York
COS_DB_PATH=data/chief.sqlite3
# Optional token for browser/API access (set in the dashboard's connection dialog)
COS_API_TOKEN=
# Opt-in macOS bridge. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
COS_BRIDGE_TOKEN=
# Exact Apple IDs / phone numbers. Only these senders can issue commands or receive replies.
COS_IMESSAGE_ALLOWLIST=
# Enable only after reading docs/IMESSAGE.md. All outgoing texts still need dashboard approval.
COS_IMESSAGE_ENABLED=false
COS_URL=http://127.0.0.1:8000

# Optional live Streamable HTTP MCP servers; copy docs/connectors.example.json and edit it.
COS_MCP_CONFIG=

# Optional: your own Messages handle, to accept /cos commands in a self-chat. Must also be allowlisted.
COS_IMESSAGE_SELF_HANDLE=

# Enforced roles, separate approver and signed proposal integrity. See docs/SECURITY.md.
# Generate config and credentials: uv run python scripts/setup_auth.py
# Set BOTH values below from the generated files to enable authenticated mode.
COS_AUTH_REQUIRED=false
COS_AUTH_CONFIG=
COS_APPROVAL_SECRET=
# Bridge can propose but never approve; secure-mode tool scopes default to local capabilities.
COS_BRIDGE_TOOLS=tasks_*,memory_*,imessage_*
